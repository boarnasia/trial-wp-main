# イメージとポート
WP_IMAGE={{WP_IMAGE}}
WP_DEBUG_PORT={{DEBUG_PORT}}

# サイト URL（リバースプロキシ経由の公開 URL）
WP_HOME=https://{{DOMAIN}}
WP_DEBUG=1
WP_TABLE_PREFIX=wp_

# 共有 MySQL（wp-main が持つ）の中で使う schema。接続情報は wp-main の .env にある
WP_DB_NAME={{SITE_ID}}

# 初期セットアップ用の管理者（change-me は devenv install がランダム値に置き換える）
WP_TITLE={{TITLE}}
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me
WP_ADMIN_EMAIL=admin@example.com
