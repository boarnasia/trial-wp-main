# イメージとポート
WP_IMAGE={{WP_IMAGE}}
WP_DEBUG_PORT={{DEBUG_PORT}}

# サイト URL（リバースプロキシ経由の公開 URL）
WP_HOME=https://{{DOMAIN}}
WP_DEBUG=1
WP_TABLE_PREFIX=wp_

# データベース（change-me は dev-env:install がランダム値に置き換える）
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# 初期セットアップ用の管理者
WP_TITLE={{TITLE}}
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me
WP_ADMIN_EMAIL=admin@example.com
