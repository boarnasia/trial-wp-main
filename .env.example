WP1_DOMAIN=local.wp1.yamashita109.com
WP2_DOMAIN=local.wp2.yamashita109.com
DASHBOARD_DOMAIN=local.wp-main.yamashita109.com

# ダッシュボード（Django）の秘密鍵。devenv install と dev-env:migration 3 がランダム値を入れる
DJANGO_SECRET_KEY=change-me

# ダッシュボード（serve）が 127.0.0.1 で待ち受けるポート。Caddy も同じ値に転送する（既定は 8000）
# 変えたら、serve を再起動し、wp-main で docker compose up -d を実行して Caddy に反映する
# DASHBOARD_PORT=8000

# Caddy が 80/443 を公開するアドレス（既定は 127.0.0.1）。LAN の他端末から使うときだけ 0.0.0.0 にする
# 0.0.0.0 にすると、同じ LAN からダッシュボードのパスワードも見える。そのためダッシュボードからのサイトの起動・停止は無効になる
# PROXY_BIND_ADDRESS=0.0.0.0

# 共有 MySQL（全サイトが schema を分けて使う）。change-me は devenv install と dev-env:migration 6 がランダム値に置き換える
DB_USER=wordpress
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

# 共有 MySQL をホストに公開するポート（127.0.0.1 だけ。既定は 3306）
# MYSQL_PORT=3306
