WP1_DOMAIN=local.wp1.yamashita109.com
WP2_DOMAIN=local.wp2.yamashita109.com
DASHBOARD_DOMAIN=local.wp-main.yamashita109.com

# ダッシュボード（Django）の秘密鍵。devenv install と dev-env:migration 3 がランダム値を入れる
DJANGO_SECRET_KEY=change-me

# CLI がダッシュボードの操作履歴 API を呼ぶときのトークン。devenv install と dev-env:migration 4 がランダム値を入れる
DASHBOARD_API_TOKEN=change-me

# Caddy が 80/443 を公開するアドレス（既定は 127.0.0.1）。LAN の他端末から使うときだけ 0.0.0.0 にする
# 0.0.0.0 にすると、同じ LAN からダッシュボードのパスワードも見える
# PROXY_BIND_ADDRESS=0.0.0.0
